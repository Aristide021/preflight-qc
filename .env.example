# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — Template
# Copy this to .env and fill in the values for local development.
# In production (Cloud Run), these are sourced from Google Secret Manager.
#
# NEVER commit .env — it's in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── ClickHouse Cloud ──────────────────────────────────────────────────────────
# Get these from: ClickHouse Cloud console → Service → Connect
CLICKHOUSE_HOST=your-service.us-east-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password
CLICKHOUSE_DATABASE=preflight
# Set to true for ClickHouse Cloud (TLS required); false for local dev
CLICKHOUSE_SECURE=true

# ── Google Cloud / Gemini ─────────────────────────────────────────────────────
# Option A: API key (simpler for local dev)
GOOGLE_API_KEY=your_google_api_key

# Option B: Vertex AI (used in Cloud Run / production)
# GOOGLE_PROJECT_ID=your_gcp_project_id
# GOOGLE_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Agent settings ────────────────────────────────────────────────────────────
# Gemini model to use for all agents
GEMINI_MODEL=gemini-flash-latest
# Max tokens for spec analysis (spec documents can be long)
GEMINI_MAX_TOKENS=8192
# Enable agent reasoning traces (useful for debugging + demo)
AGENT_TRACE_ENABLED=true

# ── Application ───────────────────────────────────────────────────────────────
# Environment: local | staging | production
APP_ENV=local
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Port for local web server
PORT=8080

# ── Delivery spec ────────────────────────────────────────────────────────────
# URL of the Netflix IMF delivery spec (fetched at runtime, not hardcoded)
# This makes the Spec-Reader agent ground on the live spec, not a stale copy.
NETFLIX_SPEC_URL=https://partnerhelp.netflixstudios.com/hc/en-us/articles/115001138508
# Cache TTL for fetched specs (seconds) — 24 hours
SPEC_CACHE_TTL_SECONDS=86400

# ── Photon (optional live validation) ────────────────────────────────────────
# Only needed if enabling live Photon validation in the agent loop (Phase 3 bonus)
# PHOTON_DOCKER_IMAGE=photon-validator
# PHOTON_WORKSPACE_PATH=/tmp/photon_workspace
